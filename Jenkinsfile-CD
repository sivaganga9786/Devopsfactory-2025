pipeline {
    agent { label 'build' }

    parameters {
        string(name: 'IMAGETAG', defaultValue: 'latest', description: 'Please Enter the Image Tag to Deploy?')
    }

    environment {
        PASSWD = credentials('github') // This should be a Jenkins credential ID (Secret Text or Username+Password)
    }

    stages {
        stage('Deploy') {
            steps {
                git branch: 'feature/terraform-ci', credentialsId: '', url: 'https://github.com/sivaganga9786/Devopsfactory-2025.git'

                dir ("./kubernetes") {
                    sh "sed -i 's|image: sivaganesh07.*|image: sivaganesh07/agguci:${IMAGETAG}|' deployment.yml"
                }

                sh "git commit -a -m \"New deployment for Build ${IMAGETAG}\""
                sh "git push https://sivaganga9786:${PASSWD}@github.com/sivaganga9786/Devopsfactory-2025.git"
            }
        }
    }
}


