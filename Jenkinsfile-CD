pipeline {
    agent { label 'build' }

    parameters {
        string(name: 'IMAGETAG', defaultValue: 'latest', description: 'Please Enter the Image Tag to Deploy?')
    }

    stages {
        stage('Deploy') {
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'PASSWD')]) {
                    git branch: 'feature/terraform-ci',
                        credentialsId: 'github', // Use Jenkins credentials here
                        url: 'https://github.com/sivaganga9786/Devopsfactory-2025.git'

                    dir("./kubernetes") {
                        sh "sed -i 's|image: sivaganesh07.*|image: sivaganesh07/agguci:${IMAGETAG}|' deployment.yml"
                    }

                    sh '''
                        if ! git diff --quiet; then
                            git commit -a -m "New deployment for Build ${IMAGETAG}"
                            git push https://sivaganga9786:${PASSWD}@github.com/sivaganga9786/Devopsfactory-2025.git
                        else
                            echo "No changes to commit. Skipping push."
                        fi
                    '''
                }
            }
        }
    }
}



